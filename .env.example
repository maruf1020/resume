# Copy to .env.local and fill in. These are read on the server only: never prefix them with NEXT_PUBLIC_.

# ---------- database ----------
# Postgres connection string; a Neon database works well. Required. The schema is migrations/*.sql,
# applied automatically on start (or by hand: `npm run db:migrate`, `npm run db:migrate -- --check`).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ---------- admin login (Better Auth: email + password, then a 6-digit code) ----------
# Create the one admin account once with: npm run admin:create -- --email you@example.com
# Signs and encrypts the login cookies and codes. 32+ random characters; required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs every device out and makes the admin's backup codes stop working.
BETTER_AUTH_SECRET=
# The site's public address (where /admin and /api/auth live). http:// makes the cookies non-Secure,
# which is only right for local testing.
BETTER_AUTH_URL=http://localhost:3000
# TEMPORARY: a fixed sign-in code (4-10 digits). While it is set, nothing is emailed and every sign-in
# accepts this code (the page still says "check your email"); the password is then the only secret.
# Remove it once MAIL_PROVIDER sends real codes. The server prints a warning at every start while it is set.
ADMIN_OTP_STATIC=112233
# How sign-in codes are sent: log (print to the server log; development default), none (production
# default; needs ADMIN_OTP_STATIC), resend (needs RESEND_API_KEY and MAIL_FROM).
# MAIL_PROVIDER=resend
# MAIL_FROM="Maruf <no-reply@your-domain.example>"
# RESEND_API_KEY=

# ---------- personas ----------
# Which persona each request shows. single = DEFAULT_PERSONA everywhere (default);
# host = by host name (PERSONA_HOSTS, or each persona's own site settings in the admin);
# prefix = by path (PERSONA_PREFIXES), e.g. /biodata/.
# PERSONA_ROUTING=single
# DEFAULT_PERSONA=job
# PERSONA_HOSTS=job=maruf.example,www.maruf.example;marriage=biodata.example
# PERSONA_PREFIXES=marriage=/shadi
# Signs visitor access cookies (unlocked details), the admin's draft preview and PDF print links. 32+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PERSONA_SIGNING_SECRET=

# ---------- documents (PDFs printed at each publish) ----------
# Where they are kept: outside public/, served by /d/<file> only to visitors allowed to see them. Keep it
# on a disk that survives deploys. Default var/documents (git-ignored).
# DOCS_DIR=var/documents
# Chrome or Chromium for printing (found automatically in the usual places). Without one the PDF step is skipped.
# CHROME_PATH=/usr/bin/chromium
# The address this server can reach itself on, for printing (default http://127.0.0.1:$PORT).
# PDF_BASE_URL=http://127.0.0.1:3000

# Number of reverse proxies in front of the app that set X-Real-IP / X-Forwarded-For (nginx = 1).
# 0 ignores those headers, since visitors can forge them; rate limits are then shared by everyone.
# Production behind nginx: 1 (ecosystem.config.cjs sets it). The server warns at startup when it is 0 in production.
TRUST_PROXY_HOPS=0

# ---------- AI ----------
# AI answers for questions none of the curated answers cover (Google Gemini). Leave empty to turn them
# off: the chat then says "outside what this chat covers" as before. Server-only, like everything above.
GEMINI_API_KEY=
# AI_MODEL=gemini-2.5-flash                     # a Flash-class model with JSON output (default; GEMINI_MODEL also works)
# AI_FALLBACK_MODEL=gemini-3.5-flash-lite       # asked too when the first model is slow (5 s), busy or gone; empty to disable
# AI_EMBEDDING_MODEL=gemini-embedding-2         # the knowledge index (768 dimensions)
# AI_DAILY_LIMIT=500                            # answered free-form questions per day, all visitors together (cost cap)

# ---------- optional ----------
# ENABLE_HSTS=1            # only once the site is served over HTTPS for good
# NEXT_PUBLIC_BASE_PATH=
# Public address of the site (canonical links, Open Graph, robots.txt, sitemap.xml). Set it in production.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ---------- SEO (optional, all public values) ----------
# Search Console "HTML tag" token and Bing Webmaster "msvalidate.01" token (just the content value).
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# IndexNow key (8-128 letters/digits/dashes); served at /indexnow.txt, used by `npm run seo:indexnow`.
# INDEXNOW_KEY=
# Date shown to search engines as lastModified (YYYY-MM-DD); bump when content changes.
# CONTENT_UPDATED=2026-10-03
