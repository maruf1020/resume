# Copy to .env.local and fill in. These are read on the server only: never prefix them with NEXT_PUBLIC_.

# The admin code typed into the chat to open /admin/. 8 to 128 characters, no spaces, with a letter, a
# digit and an uppercase letter or a symbol (anything else is never sent to the server), no "$", and not
# containing a topic word like "projects". Use a random code of 16 or more characters. Either set it in
# plain text... (left empty here on purpose: admin sign-in stays off until you set your own value)
FEEDBACK_ADMIN_CODE=
# ...or (recommended) store only its scrypt hash: run `npm run -s admin:hash`, paste the output here and
# delete FEEDBACK_ADMIN_CODE. When both are set, the hash wins. Keep the colon format the script prints:
# a "$" form would be mangled, because Next.js expands $VARIABLES in .env files.
# FEEDBACK_ADMIN_CODE_HASH=scrypt:32768:8:1:<salt>:<hash>

# Signs admin session cookies. At least 32 characters; required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave nothing sample-like here: an empty or short value disables admin sessions in production.
ADMIN_SESSION_SECRET=

# Postgres connection string; a Neon database works well. Required. Tables are created on first use.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Number of reverse proxies in front of the app that set X-Real-IP / X-Forwarded-For (nginx = 1).
# 0 ignores those headers, since visitors can forge them; rate limits are then shared by everyone.
# Production behind nginx: 1 (ecosystem.config.cjs sets it). The server warns at startup when it is 0 in production.
TRUST_PROXY_HOPS=0

# AI answers for questions none of the curated answers cover (Google Gemini). Leave empty to turn them
# off: the chat then says "outside what this chat covers" as before. Server-only, like everything above.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash                 # a Flash-class model with JSON output (default)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite   # asked too when the first model is slow (5 s), busy or gone; empty to disable
# AI_DAILY_LIMIT=500                            # answered free-form questions per day, all visitors together (cost cap)

# Optional
# ENABLE_HSTS=1            # only once the site is served over HTTPS for good
# ADMIN_COOKIE_INSECURE=1  # local http testing of a production build only
# NEXT_PUBLIC_BASE_PATH=
# Public address of the site (canonical links, Open Graph, robots.txt, sitemap.xml). Set it in production.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
